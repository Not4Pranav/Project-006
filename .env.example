# ============================================================================
# Multi-Sniper v2.0 configuration
# ============================================================================
# HOW TO USE THIS FILE
#   1) Copy it to a PRIVATE file named `.env` (never commit that file):
#
#          cp .env.example .env
#
#   2) Fill in your own values. Everything except DISCORD_TOKEN has a safe
#      default, so you can leave most of this file untouched.
#   3) `.env` is git-ignored and is loaded automatically by bot.py at startup
#      (python-dotenv). Hosting providers: set these as environment variables
#      in your host's secret manager instead of a file.
#
# SAFETY
#   - Keep real tokens, passwords, API keys, and proxy credentials out of git.
#   - This template deliberately ships with every credential field blank.
#   - bot.py redacts credentials from log output and validates configuration
#     before connecting to Discord.
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
# The bot cannot start without this.
# Where to get it: Discord Developer Portal -> your app -> Bot -> Reset Token.
# Keep the token on a single line; no quotes, no spaces, no line breaks.
DISCORD_TOKEN=

# --- Channel targeting (optional) ------------------------------------------
# The single text channel the bot watches. Blank = watch every channel the bot
# can see. If both this and LOG_CHANNEL_ID are blank, the bot still works, it
# just answers in every visible channel.
# To find an ID: Discord -> Settings -> Advanced -> Developer Mode ON,
# right-click the channel -> Copy Channel ID.
TARGET_CHANNEL_ID=

# Optional: when a name is found free, post a quick mention + name here.
# Blank = logging off. Use a private channel only the bot can see.
LOG_CHANNEL_ID=

# --- Checking behaviour -----------------------------------------------------
# Per-outbound-request timeout (seconds). Clamped below RESPONSE_BUDGET_SECONDS
# so one slow platform cannot delay the reaction. Keep small; 3 is a good default.
CHECK_TIMEOUT=3

# Hard budget (seconds) allowed from a valid message through checks + reactions.
# Clamped in code to [0.5, 4.8] so a typo cannot push reactions past 5 seconds.
RESPONSE_BUDGET_SECONDS=4.5

# Cap (seconds) for each Discord reaction REST call. Free-platform reactions
# run concurrently so this is a per-call cap, not a sum.
REACTION_TIMEOUT=0.75

# Anti-abuse cooldown: how many checks one user may fire in USER_WINDOW_SECONDS.
# The check after that gets the hourglass reaction (⏳). Defaults are sub-second
# so checking feels instant; raise USER_WINDOW_SECONDS only if you need a
# stricter anti-spam guard.
USER_MAX_CHECKS=5
USER_WINDOW_SECONDS=0.5

# --- Smart caching ----------------------------------------------------------
# Reuse the answer for a given name. A cache hit answers in microseconds with
# no network calls at all, which is what makes repeat checks feel instant.
# Different TTLs for taken vs available:
#   - TAKEN names are cached longer (they rarely free up quickly)
#   - AVAILABLE names are cached shorter (they might get sniped fast)
# RESULT_CACHE_TTL is the base value: leave the other two blank and they
# default to 2x it (taken) and 0.4x it (available). Set them to 0 to disable.
RESULT_CACHE_TTL=300
CACHE_TTL_TAKEN=600
CACHE_TTL_AVAILABLE=120

# Hard ceiling on cached usernames. The cache is pruned on write (stale first,
# then oldest) so a busy server cannot grow it without bound. Range: 64-1000000.
CACHE_MAX_ENTRIES=5000

# --- Extra platforms --------------------------------------------------------
# Enable or disable the extra platform checks (GitHub, Steam, Reddit, Instagram,
# Twitter/X). Set to "false" to only check Minecraft + guns.lol + Discord.
ENABLE_EXTRA_PLATFORMS=true

# --- Discord username check (optional, safe default: off) -------------------
# Discord's account username eligibility route returns JSON {"taken": true|false}.
# It is an account/registration-flow endpoint rather than the public bot API,
# so use it only when your deployment and Discord's current policies permit it.
# The bot never claims a name and never sends the bot token to this endpoint.
#
#   off       = skip the Discord check (recommended default)
#   dnsrobot  = load DNS Robot's username-checker page in Chromium and read
#               its rendered Discord result
#   account   = POST {"username": "..."} to the account API below
#   account_api = compatibility alias for account
#   probe     = GET an explicit authorized checker URL (200=taken, 404=free)
DISCORD_CHECK_MODE=off

# dnsrobot loads the fixed public page at
# https://dnsrobot.net/username-checker?u=<username> in an isolated Chromium
# context. The page makes its own credential-free browser request; no DNS Robot
# URL/token or account/probe credential is needed. Install Chromium separately:
#   python -m playwright install chromium
# A page block, rate limit, timeout, or ambiguous result remains UNKNOWN.

# Used by DISCORD_CHECK_MODE=account. The default is Discord's first-party
# username eligibility route. Set this only when an authorized account API
# gateway exposes the same JSON contract. An account-scoped endpoint can be
# supplied explicitly, e.g. https://discord.com/api/v10/users/@me/pomelo-attempt.
DISCORD_ACCOUNT_API_URL=

# Optional credential sent ONLY to DISCORD_ACCOUNT_API_URL. Leave blank for
# Discord's unauthenticated registration-flow route. Do not put a personal
# Discord client token here; use only an authorized API/OAuth credential.
DISCORD_ACCOUNT_API_TOKEN=
DISCORD_ACCOUNT_API_TOKEN_HEADER=Authorization
DISCORD_ACCOUNT_API_TOKEN_SCHEME=Bearer

# Used when DISCORD_CHECK_MODE=probe. Leave blank to skip the external probe.
# Example:
#   https://my-checker.example/name/{username}
# The bot substitutes the username into {username} and treats 200 = taken,
# 404 = free, 401/403/429 = unknown.
DISCORD_PROBE_URL=

# Optional credential sent ONLY to DISCORD_PROBE_URL, never logged or committed.
# Keep blank unless your checker requires auth.
DISCORD_PROBE_TOKEN=

# Header that carries the probe token above (e.g. Authorization or X-API-Key).
DISCORD_PROBE_TOKEN_HEADER=Authorization

# Prefix before the probe token (e.g. Bearer). Set blank to send the raw token.
DISCORD_PROBE_TOKEN_SCHEME=Bearer

# --- Proxy pool (optional) --------------------------------------------------
# Route outbound platform checks through proxies. Supports TWO modes:
#
# SINGLE PROXY (backward compatible):
#   PROXY_URL=http://user:pass@proxy.example:8080
#
# PROXY POOL (rotation + failover):
#   PROXY_URLS=http://proxy1:8080,http://proxy2:8080,http://user:pass@proxy3:8080
#
# The proxy pool provides:
#   - Round-robin rotation across healthy proxies, resolved PER REQUEST, so the
#     eight platform checks in one lookup spread across eight different IPs
#   - Live health reporting: a proxy that fails a real check is benched
#     immediately, and the retry lands on the next proxy in the rotation
#   - Concurrent health checks every 30 seconds (all proxies probed at once)
#   - Dead-proxy cooldown with automatic recovery after 60 seconds
#
# You can use BOTH: PROXY_URL is added to the pool automatically.
# Leave blank for a direct connection.
# Credentials belong only in your private .env / host secrets, never in git.
PROXY_URL=
PROXY_URLS=

# What to do when EVERY proxy is benched.
#   false (default) = keep using proxies (reset the failure counters and retry)
#   true            = fall back to a direct, unproxied connection
# The default is false on purpose: a direct fallback would expose this host's
# real IP to the platforms, which is usually the exact reason proxies were
# configured. Only set this to true if you treat proxies as a speed
# optimisation rather than a privacy boundary.
PROXY_ALLOW_DIRECT_FALLBACK=false
