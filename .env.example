# ============================================================
# Multi-Sniper configuration
# 1) Copy this file:   cp .env.example .env
# 2) Fill in DISCORD_TOKEN (required) and anything else you want
# 3) NEVER commit or share your real .env file
# ============================================================

# --- REQUIRED ------------------------------------------------
# Bot token: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# --- Channel targeting ---------------------------------------
# The single text channel the bot watches. Blank = watch every channel.
# Get an ID: Discord Settings -> Advanced -> Developer Mode ON,
# then right-click the channel -> Copy Channel ID
TARGET_CHANNEL_ID=

# Optional: separate channel where "available" hits get logged
LOG_CHANNEL_ID=

# --- Checking behaviour --------------------------------------
# Per-outbound-request timeout in seconds. It is clamped below the response
# budget so one slow platform cannot delay the reaction indefinitely.
CHECK_TIMEOUT=3

# Hard valid-message budget from Discord event handling through reactions.
# The bot reserves time for Discord's reaction REST call; values are clamped
# below 5 seconds in code.
RESPONSE_BUDGET_SECONDS=4.5
# Cap for each reaction API call. Available-platform reactions run in parallel.
REACTION_TIMEOUT=0.75

# Anti-abuse cooldown: max checks per user per window
USER_MAX_CHECKS=3
USER_WINDOW_SECONDS=60

# Cache repeat lookups for this many seconds (protects you from rate limits)
RESULT_CACHE_TTL=300

# --- Discord username check ----------------------------------
# Discord has NO public username-availability API.
#   off    = skip the Discord check (recommended, honest default)
#   probe  = query an explicit, authorized checker URL you control. A blank
#            DISCORD_PROBE_URL is skipped; discord.com/<username> is NOT a
#            valid availability endpoint.
DISCORD_CHECK_MODE=off
# DISCORD_PROBE_URL=https://your-checker.example/{username}

# --- Networking (optional) -----------------------------------
# Route outbound platform checks through an HTTP(S) proxy, e.g.
# http://user:pass@proxy-host:port  (rotating/backconnect recommended)
# SOCKS proxies need the extra 'aiohttp-socks' package.
PROXY_URL=
